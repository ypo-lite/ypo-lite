<?xml version="1.0" encoding="utf-8"?>
<!--
	y-pop — application launcher, driven by hotkeys and popup menus.

	Copy this file next to y-pop.exe to keep it portable, or to
	%APPDATA%\Ypo-Lite\y-pop.xml. Either place is read on start-up, after a
	save in y-pop-config, and on ">Reload configuration" in the search window.

	README.md is the full reference for this file; docs/user-manual.md covers
	<search>.
-->
<!--
	theme picks a base skin: "native" (the default if omitted) keeps plain,
	unthemed OS chrome; "default"/"flat"/"dark" are PortAL's own three
	built-in skins, reproduced with PortAL's own colours/border/gradient
	values (except that "default" has readable black hover text);
	"graphite", "midnight" and "sand" are y-pop's own; "auto" resolves
	live, each time the menu opens, to "default" or
	"dark" to match Windows' current light/dark setting.

	A <skin> child of <y-pop> overrides individual parts of whichever theme
	is active, e.g. <skin back-color="1a1a1a" hover-back-color="ff8800"/> —
	a colour value is "RRGGBB" or "RRGGBBAA", the "#" prefix is optional.
	Setting one without also setting theme="..." still themes the popup (as
	if theme="auto" had been written too); every slot not mentioned keeps
	the base theme's own value:
	  back-color, text-color, hover-back-color, hover-text-color,
	  disabled-text-color
	  padding — gap BETWEEN rows, in pixels (0 in PortAL's three skins —
	    PortAL has no such gap; this is a y-pop-only addition)
	  margin — gap WITHIN a row, between its border and its own icon/text,
	    in pixels (also 0 in every built-in skin, also y-pop-only)
	  edge — "idle", "hover", or "always": draws a vertical rule between
	    the icon column and the text on rows in that state ("default" is
	    "idle", "dark" is "always", "flat" sets none). Not PortAL's own
	    edge="true"/"sel"/"unsel" — those name which ODS_SELECTED bit is
	    set, not which rows the rule actually appears on, which reads
	    backwards from what the words say; "idle"/"hover"/"always" name
	    the actual row state instead.
	  separator — "after-icons" (every built-in skin) starts the line of an
	    untitled separator just past the icon column, which runs on through
	    it; "full" takes the whole row. A titled one always takes the row.
	<skin> can also carry child elements, each optional and independently
	all-or-nothing (an incomplete one warns and is dropped):
	  <border size="1" round="8" color="3a3a3a"/>
	  <background-gradient start="2b2b2b" end="1a1a1a" direction="v"/>
	    (direction is "h" or "v", default "h")
	  <icon-gradient start="ffd996" end="000000" direction="h"/>
	    extra background painted behind the icon column only, idle rows
	    only (a hovered/selected row's own fill already covers it) — same
	    start/end/direction shape as <background-gradient>. A flat colour
	    is written with start and end the same.

	The search window follows the menus' theme and <skin> unless <search>
	has a theme="..." and/or a <skin> of its own. They never mix: a theme
	on <search> drops the menus' <skin>, and a <skin> on <search> replaces
	theirs (on the menus' theme unless <search> names one). It takes the
	five colours and <border> (its outline and corners); the rest of a
	<skin> is about menu rows, and warns under <search>.
-->
<y-pop shell-execute="false" show-shortcuts="true" popup="native" theme="auto">

	<!--
		Variables usable as %name% anywhere below, expanded once at load
		(alongside the builtins: %win%, %system%, %programfiles%, %mydocs%,
		%desktop%, %appdata%, %user%, %pop%, %config%, …).

		%clipboard%/%clipboards% are deliberately never expanded here — they
		are resolved lazily, right before a node launches.
	-->
	<variables>
		<var name="docs" value="%mydocs%"/>
	</variables>

	<!--
		Every direct child of <y-pop> becomes its own tray icon (a <group>)
		or launches immediately on tray click (an <app>).
	-->
	<group name="y-pop">
		<hotkey key="Win+Y"/>

		<separator name="Tools"/>
		<app name="Command line" exe="%system%\cmd.exe" path="C:\"/>
		<!--
			override="true": only takes effect if Win+N is already claimed
			elsewhere and the normal registration fails — never tried
			proactively.
		-->
		<app name="Notepad" exe="%win%\notepad.exe">
			<hotkey key="Win+N" override="true"/>
		</app>

		<group name="Explorers">
			<app name="File Explorer" exe="%win%\explorer.exe"/>
			<!--
				"path,index" overrides the icon shown for an entry — a
				positive index picks the icon at that position within the
				file; a negative one (Windows' own convention, e.g. how a
				.lnk's own icon location works) picks it by resource id
				instead, stable across a Windows version reordering the
				file's icons. -41 is illustrative here, not verified against
				every Windows version — if it doesn't resolve to the
				Recycle Bin icon on yours, the entry still works, just
				without a custom icon.
			-->
			<app name="Recycle Bin" exe="%win%\explorer.exe" icon="%win%\explorer.exe,-41"/>
		</group>

		<app name="Recent documents" exe="%docs%" browse="true" filter="*.*"/>

		<separator/>
		<settings/>
		<about/>
		<quit/>
	</group>

</y-pop>
