// Resource script: compiled by build.rs through the `embed-resource` crate.
//
// Identifiers must stay in sync with `src/resources.rs`.
// Paths are relative to this file.
//
// The version numbers below are checked against Cargo.toml at build time,
// so bumping the crate version without touching this file fails the build.

/////////////////////////////////////////////////////////////////////////////
// Icons
//
// The lowest-numbered icon resource becomes the icon Explorer shows for the
// executable, so keep IDI_APP_ICON first.

#define IDI_APP_ICON 101

IDI_APP_ICON ICON "usb.minimal.ico"

/////////////////////////////////////////////////////////////////////////////
// Application manifest
//
// 1  = CREATEPROCESS_MANIFEST_RESOURCE_ID
// 24 = RT_MANIFEST

1 24 "win-rust-min.exe.manifest"

/////////////////////////////////////////////////////////////////////////////
// Version information (Explorer's "Details" tab)

1 VERSIONINFO
 FILEVERSION    0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L   // VOS_NT_WINDOWS32
 FILETYPE       0x1L       // VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"   // US English, Unicode
        BEGIN
            VALUE "CompanyName",      "guipro"
            VALUE "FileDescription",  "Minimal Windows tray application"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "win-rust-min"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "win-rust-min.exe"
            VALUE "ProductName",      "Win Rust Min"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
